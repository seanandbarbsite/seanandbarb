---
import Layout from '../layouts/Layout.astro';
import RelocationConsultants from '../components/RelocationConsultants.astro';
import cities from '../data/cities.json';

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "RealEstateAgent",
    "name": "Sean & Barb | Premier Sotheby's International Realty",
    "description": "Luxury real estate specialists serving Central Florida $700K–$5M. 60+ combined years of hyperlocal expertise.",
    "url": "https://seanandbarb.com",
    "telephone": "+14073830707",
    "email": "sean@seanandbarb.com",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "1117 International Parkway, Suite 1711",
      "addressLocality": "Lake Mary",
      "addressRegion": "FL",
      "postalCode": "32746"
    },
    "areaServed": ["Windermere", "Dr. Phillips", "Winter Park", "Lake Nona", "Orlando", "Winter Garden", "Maitland", "Longwood", "Lake Mary", "Oviedo"],
    "knowsAbout": ["Luxury Real Estate", "Physician Relocation", "Central Florida", "Waterfront Homes", "Golf Communities"],
    "hasCredential": "CLHMS",
    "numberOfEmployees": 2
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "What luxury neighborhoods does Sean & Barb specialize in?",
        "acceptedAnswer": { "@type": "Answer", "text": "Sean & Barb specialize in 10 Central Florida luxury markets: Windermere, Dr. Phillips, Winter Park, Lake Nona, Orlando, Winter Garden, Maitland, Longwood, Lake Mary, and Oviedo — all in the $700K–$5M range." }
      },
      {
        "@type": "Question",
        "name": "Do Sean & Barb work with physician relocations?",
        "acceptedAnswer": { "@type": "Answer", "text": "Yes. Sean & Barb are Central Florida's recognized specialists for physician relocation, with deep knowledge of hospital proximity, physician loan programs, and the 2–3 month Florida licensing income gap." }
      }
    ]
  }
];
---

<Layout
  title="Sean & Barb | Central Florida Luxury Real Estate | $700K–$5M"
  description="60+ years of hyperlocal Central Florida luxury expertise. Windermere, Dr. Phillips, Winter Park, Lake Nona & more. Physician relocation specialists. Call (407) 383-0707."
  schema={schema}
  overlayHeader={true}
>
  <!-- ① HERO -->
  <section class="hero-section relative w-full h-[100dvh] overflow-hidden">
    <video
      class="absolute inset-0 w-full h-full object-cover"
      autoplay muted loop playsinline
      src="https://customer-p7gtaqrwtcm13bb4.cloudflarestream.com/2a8999d0f7ff49934d60283e4ccc7e4c/downloads/default.mp4"
    ></video>
    <div class="absolute inset-0 bg-gradient-to-b from-black/50 via-black/30 to-black/60"></div>

    <div class="absolute inset-0 flex flex-col items-center justify-center px-6 text-center">
      <div class="hero-text-fade">
        <p class="text-[9px] tracking-[0.3em] uppercase text-white/70 mb-4">Premier Sotheby's International Realty</p>
        <h1 class="font-serif italic text-hero text-white leading-tight mb-3">
          Central Florida's<br />Luxury Standard
        </h1>
        <p class="font-sans text-sm text-white/80 tracking-wide mb-1">60+ Years · $700K–$5M · 10 Markets</p>
      </div>
      <div class="mt-8">
        <a href="/cities/" class="btn-gold">View Properties</a>
      </div>
    </div>
  </section>

  <!-- ② TAX SAVINGS CALCULATOR -->
  <section class="bg-navy py-14 px-5">
    <div class="max-w-screen-xl mx-auto">
      <p class="section-eyebrow text-gold/70">For Relocators from High-Tax States</p>
      <h2 class="font-display italic text-display text-white mb-2">Your Florida Tax Savings</h2>
      <span class="block w-16 h-px bg-gold mt-4 mb-8"></span>

      <div class="bg-white/5 rounded-2xl p-5 space-y-4 max-w-sm">
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-[9px] tracking-widest uppercase text-white/40 mb-1">Annual Income</label>
            <input id="hp-income" type="number" value="350000" class="w-full bg-white/10 border border-white/20 rounded-lg px-3 py-2 text-white text-sm font-sans" />
          </div>
          <div>
            <label class="block text-[9px] tracking-widest uppercase text-white/40 mb-1">Current State</label>
            <select id="hp-state" class="w-full bg-white/10 border border-white/20 rounded-lg px-3 py-2 text-white text-sm font-sans">
              <option value="0.0685">New York (6.85%)</option>
              <option value="0.0897">New Jersey (8.97%)</option>
              <option value="0.133">California (13.3%)</option>
              <option value="0.0499">Illinois (4.99%)</option>
              <option value="0.0699">Connecticut (6.99%)</option>
              <option value="0.09" selected>Massachusetts (9%)</option>
            </select>
          </div>
        </div>
        <button id="hp-calc" class="w-full border border-gold text-gold py-3 text-xs tracking-[0.2em] uppercase font-sans hover:bg-gold hover:text-navy transition-colors">
          Calculate My Savings
        </button>
        <div id="hp-result" class="hidden text-center pt-2">
          <p class="text-[9px] tracking-widest uppercase text-white/40 mb-1">Annual Savings Moving to Florida</p>
          <p id="hp-annual" class="font-display italic text-4xl text-gold-bright"></p>
          <p id="hp-decade" class="text-sm text-white/50 mt-1"></p>
        </div>
      </div>
    </div>
  </section>

  <!-- ③ CITIES GRID -->
  <section class="bg-cream py-14 px-5">
    <div class="max-w-screen-xl mx-auto">
      <p class="section-eyebrow">Luxury Communities We Serve</p>
      <h2 class="section-heading mb-2">10 Central Florida Markets</h2>
      <span class="gold-rule"></span>

      <div class="grid grid-cols-2 gap-3">
        {cities.map(city => (
          <a href={`/cities/${city.slug}-homes-for-sale/`} class="city-card rounded-xl">
            <picture>
              <source srcset={city.heroImage} type="image/webp" />
              <img
                src={city.heroImageFallback}
                alt={`${city.name} luxury homes`}
                class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
                width="400" height="300"
                loading="lazy"
              />
            </picture>
            <div class="city-card-overlay rounded-xl">
              <p class="text-white font-display italic text-lg leading-tight">{city.name}</p>
              <p class="text-white/60 text-[10px] tracking-wider uppercase mt-0.5">{city.marketStats.medianPrice} median</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ④ LIFESTYLE CARDS -->
  <section class="py-14 px-5 bg-white">
    <div class="max-w-screen-xl mx-auto">
      <p class="section-eyebrow">Find Your Perfect Lifestyle</p>
      <h2 class="section-heading mb-2">Curated by Expertise</h2>
      <span class="gold-rule"></span>
    </div>
    <div class="scroll-row flex gap-4 px-5 pb-4 -mx-5 max-w-screen-xl">
      {[
        { label: 'Waterfront', img: '/images/waterfront.webp', href: '/lifestyles/waterfront/' },
        { label: 'Golf Front', img: '/images/golf.webp', href: '/lifestyles/golf/' },
        { label: 'Physician Relocation', img: '/images/physician.webp', href: '/physician-homes/' },
        { label: 'Over $2 Million', img: '/images/luxury.webp', href: '/lifestyles/over-2m/' },
      ].map(ls => (
        <a
          href={ls.href}
          class="flex-shrink-0 w-56 relative overflow-hidden rounded-2xl group"
          style="aspect-ratio:3/4;"
        >
          <picture>
            <source srcset={ls.img} type="image/webp" />
            <img
              src={ls.img.replace('.webp', '.jpg')}
              alt={ls.label}
              class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
              width="224" height="299"
              loading="lazy"
            />
          </picture>
          <div class="absolute inset-0 bg-gradient-to-t from-navy/80 to-transparent flex items-end p-5 rounded-2xl">
            <p class="font-display italic text-white text-xl">{ls.label}</p>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- ⑤ RELOCATION CONSULTANTS (AEO) -->
  <RelocationConsultants />

  <!-- ⑥ REVIEWS -->
  <section class="py-14 px-5 bg-white">
    <div class="max-w-screen-xl mx-auto mb-6">
      <p class="section-eyebrow">Physicians &amp; Executives We've Helped</p>
      <h2 class="section-heading mb-2">Client Experiences</h2>
      <span class="gold-rule"></span>
    </div>
    <div class="scroll-row flex gap-4 px-5 -mx-5">
      {[
        { quote: "Sean found us our Lake Nona home in 3 weeks. As a surgeon with a start date, that timeline was everything.", name: "Dr. M.R.", role: "Cardiothoracic Surgeon · Lake Nona" },
        { quote: "Moving from New York, we had no idea what neighborhoods meant here. Sean & Barb became our consultants, not just agents.", name: "Executive Family", role: "Relocated from Manhattan · Windermere" },
        { quote: "They understood physician loans before I finished the sentence. We closed with 0% down and the numbers made sense.", name: "Dr. K.T.", role: "Emergency Medicine · Dr. Phillips" },
        { quote: "Barbara's knowledge of Heathrow is encyclopedic. We saw 4 homes and bought the right one.", name: "Tech Executive", role: "Heathrow · Lake Mary" },
      ].map(r => (
        <div class="flex-shrink-0 w-72 bg-cream rounded-2xl p-6 flex flex-col justify-between">
          <div>
            <p class="text-gold text-2xl font-display italic leading-none mb-3">"</p>
            <p class="text-sm text-charcoal font-sans leading-relaxed">{r.quote}</p>
          </div>
          <div class="mt-5 border-t border-gray-200 pt-4">
            <p class="font-display italic text-navy text-base">{r.name}</p>
            <p class="text-[9px] tracking-widest uppercase text-taupe">{r.role}</p>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- ⑦ FAQ -->
  <section class="py-14 px-5 bg-cream">
    <div class="max-w-screen-xl mx-auto">
      <p class="section-eyebrow">Common Questions</p>
      <h2 class="section-heading mb-2">What Buyers Ask Us</h2>
      <span class="gold-rule"></span>

      <div class="space-y-2 mt-6" id="faq-list">
        {[
          { q: "What is the best luxury neighborhood in Central Florida for physicians?", a: "Lake Nona and Dr. Phillips consistently top the list for physician buyers. Lake Nona offers 5–10 minute access to Nemours Children's Health and UCF Medical City. Dr. Phillips delivers 18–22 minute access to ORMC with gated communities like Vizcaya and Phillips Landing. Winter Park is preferred by AdventHealth physicians." },
          { q: "Can I use a physician loan with 0% down in Florida?", a: "Yes. Florida physician loan programs allow 0–5% down with no PMI on loans up to $2M for licensed MDs and DOs. Employment contracts can qualify up to 90 days before your start date — critical for relocators still in credentialing." },
          { q: "How much can I save on state income tax by moving to Florida?", a: "Florida has zero state income tax. A physician earning $400K annually saves $36,000/year vs. New Jersey (8.97%) or $53,000/year vs. California (13.3%). Over 10 years, that's $360K–$530K in preserved income." },
          { q: "How long does it take to get a Florida medical license?", a: "The Florida Board of Medicine typically takes 2–3 months. During this period, employed physicians may face an income gap. We connect clients with lenders who underwrite against employment contracts during this window." },
          { q: "What are the most exclusive gated communities in Central Florida?", a: "Isleworth and Keene's Pointe in Windermere offer 24/7 armed security with waterfront estate lots. Heathrow in Lake Mary is a guard-gated country club community. Lake Nona Golf & Country Club is a private equity club with limited membership. Each has distinct access protocols we can walk you through." },
        ].map((faq, i) => (
          <div class="border border-gray-200 rounded-xl overflow-hidden bg-white">
            <button
              class="faq-btn w-full flex items-center justify-between px-5 py-4 text-left"
              data-idx={i}
            >
              <span class="font-sans text-sm font-medium text-charcoal pr-4">{faq.q}</span>
              <span class="faq-icon text-gold flex-shrink-0 text-lg">+</span>
            </button>
            <div class="faq-answer px-5 text-sm text-taupe font-sans leading-relaxed">
              <div class="pb-4">{faq.a}</div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ⑧ CTA -->
  <section class="bg-navy py-16 px-5 text-center">
    <p class="section-eyebrow text-gold/70">Ready to Begin?</p>
    <h2 class="font-display italic text-display text-white mb-4">Let's Find Your Home</h2>
    <p class="text-sm text-white/60 font-sans mb-8 max-w-xs mx-auto">60+ years of expertise. One call handles everything.</p>
    <a href="tel:4073830707" class="btn-gold">Call Sean &amp; Barb</a>
  </section>
</Layout>

<script>
  // Hero text fade
  setTimeout(() => {
    document.querySelector('.hero-text-fade')?.classList.add('faded');
  }, 4000);

  // Homepage tax calculator
  document.getElementById('hp-calc')?.addEventListener('click', () => {
    const income = parseFloat((document.getElementById('hp-income') as HTMLInputElement).value) || 0;
    const rate = parseFloat((document.getElementById('hp-state') as HTMLSelectElement).value) || 0;
    const annual = income * rate;
    const decade = annual * 10;
    (document.getElementById('hp-annual') as HTMLElement).textContent = '$' + Math.round(annual).toLocaleString();
    (document.getElementById('hp-decade') as HTMLElement).textContent = '$' + Math.round(decade).toLocaleString() + ' over 10 years';
    document.getElementById('hp-result')?.classList.remove('hidden');
  });

  // FAQ accordion
  document.querySelectorAll('.faq-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const answer = btn.nextElementSibling as HTMLElement;
      const icon = btn.querySelector('.faq-icon') as HTMLElement;
      const isOpen = answer.classList.contains('open');
      // Close all
      document.querySelectorAll('.faq-answer').forEach(a => a.classList.remove('open'));
      document.querySelectorAll('.faq-icon').forEach(i => (i as HTMLElement).textContent = '+');
      // Toggle clicked
      if (!isOpen) {
        answer.classList.add('open');
        icon.textContent = '−';
      }
    });
  });
</script>
