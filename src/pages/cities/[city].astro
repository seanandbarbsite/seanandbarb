---
import Layout from '../../layouts/Layout.astro';
import MarketStats from '../../components/MarketStats.astro';
import DriveTimeMatrix from '../../components/DriveTimeMatrix.astro';
import RelocationConsultants from '../../components/RelocationConsultants.astro';
import cities from '../../data/cities.json';

export async function getStaticPaths() {
  return cities.map(city => ({
    params: { city: `${city.slug}-homes-for-sale` },
    props: { city },
  }));
}

const { city } = Astro.props;

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "RealEstateAgent",
    "name": `Sean & Barb | ${city.name} Luxury Real Estate`,
    "description": city.metaDescription,
    "url": `https://seanandbarb.com/cities/${city.slug}-homes-for-sale/`,
    "telephone": "+14073830707",
    "areaServed": city.name,
    "address": {
      "@type": "PostalAddress",
      "addressLocality": city.name,
      "addressRegion": "FL",
      "postalCode": city.zip
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": city.voiceSearchH2s.map(q => ({
      "@type": "Question",
      "name": q,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": `Contact Sean & Barb for expert guidance on ${city.name} luxury real estate. Call (407) 383-0707 or visit seanandbarb.com.`
      }
    }))
  }
];
---

<Layout
  title={city.metaTitle}
  description={city.metaDescription}
  schema={schema}
  overlayHeader={false}
>
  <!-- Hero banner -->
  <section class="relative h-64 overflow-hidden mt-[64px]">
    <picture>
      <source srcset={city.heroImage} type="image/webp" />
      <img
        src={city.heroImageFallback}
        alt={`${city.name} luxury homes`}
        class="w-full h-full object-cover"
        width="800" height="256"
      />
    </picture>
    <div class="absolute inset-0 bg-gradient-to-t from-navy/80 to-navy/20 flex flex-col justify-end px-5 pb-6">
      <p class="text-[9px] tracking-[0.25em] uppercase text-gold mb-1">{city.zip} · {city.county} County · Last Updated {city.lastUpdated}</p>
      <h1 class="font-display italic text-3xl text-white leading-tight">{city.h1}</h1>
    </div>
  </section>

  <div class="px-5 py-10 space-y-12 max-w-screen-xl mx-auto">

    <!-- Market Stats -->
    <section>
      <p class="section-eyebrow">{city.lastUpdated} · {city.name} Luxury Pulse</p>
      <h2 class="section-heading mb-2">Current Market Stats</h2>
      <span class="gold-rule"></span>
      <MarketStats stats={city.marketStats} lastUpdated={city.lastUpdated} cityName={city.name} />
    </section>

    <!-- Narrative -->
    <section>
      <p class="section-eyebrow">The {city.name} Story</p>
      <h2 class="section-heading mb-2">{city.tagline}</h2>
      <span class="gold-rule"></span>
      <p class="text-sm text-taupe font-sans leading-relaxed">{city.narrative}</p>
    </section>

    <!-- Voice search H2s as FAQ-style sections -->
    <section>
      <p class="section-eyebrow">What Buyers Ask About {city.name}</p>
      <h2 class="section-heading mb-2">Your Questions, Answered</h2>
      <span class="gold-rule"></span>
      <div class="space-y-6">
        {city.voiceSearchH2s.map(q => (
          <div class="border-l-2 border-gold pl-4">
            <h3 class="font-sans font-medium text-sm text-navy mb-2">{q}</h3>
            <p class="text-sm text-taupe font-sans leading-relaxed">
              Contact Sean &amp; Barb for a personalized answer. With 60+ years in Central Florida,
              we have hyperlocal data on {city.name} that no algorithm can replicate.
              Call <a href="tel:4073830707" class="text-gold underline">(407) 383-0707</a>.
            </p>
          </div>
        ))}
      </div>
    </section>

    <!-- Neighborhoods -->
    <section>
      <p class="section-eyebrow">Where to Look in {city.name}</p>
      <h2 class="section-heading mb-2">Key Neighborhoods</h2>
      <span class="gold-rule"></span>
      <div class="flex flex-wrap gap-2">
        {city.neighborhoods.map(n => (
          <span class="px-4 py-2 border border-navy/20 rounded-full text-sm font-sans text-navy">{n}</span>
        ))}
      </div>
    </section>

    <!-- Drive Time Matrix -->
    {(city.hospitalProximity.length > 0 || Object.keys(city.commute).length > 0) && (
      <section>
        <DriveTimeMatrix
          hospitalProximity={city.hospitalProximity}
          commute={city.commute}
          cityName={city.name}
        />
      </section>
    )}

    <!-- iHomeFinder IDX Widget -->
    <section>
      <p class="section-eyebrow">Live MLS Data</p>
      <h2 class="section-heading mb-2">Active {city.name} Listings</h2>
      <span class="gold-rule"></span>
      <div id="idx-market-listings" class="min-h-[400px]">
        <!-- Paste iHomeFinder Market widget embed code for {city.name} here -->
        <p class="text-sm text-taupe font-sans text-center py-16">Loading listings…</p>
      </div>
    </section>

    <!-- CTA -->
    <section class="bg-navy rounded-2xl p-8 text-center">
      <p class="section-eyebrow text-gold/70">Ready to Explore {city.name}?</p>
      <h2 class="font-display italic text-2xl text-white mb-4">Let's Talk</h2>
      <p class="text-sm text-white/60 font-sans mb-6">60+ years of {city.name} expertise. One call handles everything.</p>
      <a href="tel:4073830707" class="btn-gold">Call (407) 383-0707</a>
    </section>
  </div>

  <!-- Relocation Consultants (AEO) -->
  <RelocationConsultants />
</Layout>
