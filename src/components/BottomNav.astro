---
---
<nav id="bottom-nav" class="fixed bottom-0 left-0 right-0 z-50 h-[72px] flex items-center justify-around px-2">
  <a href="/" class="bottom-tab" data-page="home">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 12L12 3l9 9M5 10v9a1 1 0 001 1h4v-5h4v5h4a1 1 0 001-1v-9"/></svg>
    <span>Home</span>
  </a>
  <button class="bottom-tab" id="btn-mortgage">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M9 7H6a2 2 0 00-2 2v9a2 2 0 002 2h9a2 2 0 002-2v-3M13 3h8m0 0v8m0-8L11 13"/></svg>
    <span>Mtg Calc</span>
  </button>
  <a href="https://seanandbarb.ihomefinder.com/idx/search/basic/" class="bottom-tab" target="_blank" rel="noopener">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/></svg>
    <span>Search</span>
  </a>
  <button class="bottom-tab" id="btn-chat">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/></svg>
    <span>Ask 24/7</span>
  </button>
  <a href="mailto:sean@seanandbarb.com" class="bottom-tab">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
    <span>Email Us</span>
  </a>
</nav>

<style>
  .bottom-tab {
    @apply flex flex-col items-center gap-0.5 text-[7.5px] tracking-wide
           text-[#4A3D34] opacity-100 whitespace-nowrap;
    font-family: 'Inter', system-ui, sans-serif;
    font-weight: 500;
    min-width: 52px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 8px 4px;
    position: relative;
  }
  .bottom-tab.active::after {
    content: '';
    position: absolute;
    bottom: 2px;
    left: 50%;
    transform: translateX(-50%);
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: #C4952A;
  }
</style>

<script>
  // Active state
  const tabs = document.querySelectorAll('.bottom-tab');
  tabs.forEach(tab => {
    const href = (tab as HTMLAnchorElement).href;
    if (href && href === window.location.href) {
      tab.classList.add('active');
    }
  });

  // Mortgage sheet trigger
  document.getElementById('btn-mortgage')?.addEventListener('click', () => {
    document.getElementById('mortgage-sheet')?.classList.add('open');
  });

  // Chat trigger
  document.getElementById('btn-chat')?.addEventListener('click', () => {
    document.getElementById('chat-sheet')?.classList.add('open');
  });
</script>
