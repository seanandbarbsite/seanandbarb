---
export interface Props { overlay?: boolean; }
const { overlay = false } = Astro.props;
---

<header
  id="site-header"
  class:list={[
    'fixed top-0 left-0 right-0 z-50 px-5 py-3',
    overlay ? 'bg-transparent' : 'bg-navy'
  ]}
>
  <div class="flex items-center justify-between max-w-screen-xl mx-auto">
    <!-- Logo -->
    <a href="/" class="flex-shrink-0">
      <img
        src="/images/premier-sothebys-vertical-white.gif"
        alt="Premier Sotheby's International Realty"
        class="h-10 w-auto"
        width="80" height="40"
      />
    </a>

    <!-- Brand name - center -->
    <a
      href="/"
      class="absolute left-1/2 -translate-x-1/2 font-display italic font-light text-[21px] tracking-[0.1em]"
      style="color: #E8B84B;"
    >
      Sean &amp; Barb
    </a>

    <!-- Hamburger -->
    <button
      id="hamburger"
      aria-label="Open menu"
      class="text-white text-2xl leading-none p-1"
    >
      ☰
    </button>
  </div>
</header>

<!-- Mobile nav drawer -->
<div id="nav-drawer" class="fixed inset-0 z-[100] pointer-events-none">
  <!-- Backdrop -->
  <div
    id="nav-backdrop"
    class="absolute inset-0 bg-navy/90 opacity-0 transition-opacity duration-300"
  ></div>

  <!-- Drawer panel -->
  <nav
    id="nav-panel"
    class="absolute top-0 right-0 h-full w-72 bg-navy-dark flex flex-col pt-20 pb-10 px-8
           translate-x-full transition-transform duration-300 ease-out"
  >
    <button id="nav-close" class="absolute top-5 right-5 text-white text-2xl">✕</button>

    <div class="flex flex-col gap-6">
      <a href="/" class="nav-link">Home</a>
      <a href="/cities/" class="nav-link">Cities</a>
      <a href="/lifestyles/" class="nav-link">Lifestyles</a>
      <a href="/physician-homes/" class="nav-link">Physician Relocation</a>
      <a href="/about/" class="nav-link">About Sean &amp; Barb</a>
      <a href="/contact/" class="nav-link">Contact</a>
    </div>

    <div class="mt-auto border-t border-white/10 pt-6">
      <a href="tel:4073830707" class="block text-white/60 text-sm mb-2">(407) 383-0707</a>
      <a href="mailto:sean@seanandbarb.com" class="block text-white/60 text-sm">sean@seanandbarb.com</a>
    </div>
  </nav>
</div>

<style>
  .nav-link {
    @apply font-display italic text-xl text-white/80 hover:text-gold-bright transition-colors duration-200;
  }
</style>

<script>
  const header = document.getElementById('site-header');
  const hamburger = document.getElementById('hamburger');
  const navClose = document.getElementById('nav-close');
  const navDrawer = document.getElementById('nav-drawer');
  const navBackdrop = document.getElementById('nav-backdrop');
  const navPanel = document.getElementById('nav-panel');

  // Scroll behavior — only activate if header starts transparent
  const isOverlay = header?.classList.contains('bg-transparent');
  if (isOverlay) {
    const onScroll = () => {
      const hero = document.querySelector('.hero-section') as HTMLElement;
      if (!hero) return;
      const past = hero.getBoundingClientRect().bottom <= 0;
      header?.classList.toggle('scrolled', past);
    };
    window.addEventListener('scroll', onScroll, { passive: true });
  }

  // Hamburger open
  hamburger?.addEventListener('click', () => {
    navDrawer!.classList.add('pointer-events-auto');
    navBackdrop!.classList.replace('opacity-0', 'opacity-100');
    navPanel!.classList.replace('translate-x-full', 'translate-x-0');
  });

  // Close
  const closeNav = () => {
    navDrawer!.classList.remove('pointer-events-auto');
    navBackdrop!.classList.replace('opacity-100', 'opacity-0');
    navPanel!.classList.replace('translate-x-0', 'translate-x-full');
  };
  navClose?.addEventListener('click', closeNav);
  navBackdrop?.addEventListener('click', closeNav);
</script>
