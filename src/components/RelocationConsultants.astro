---
---
<section class="bg-cream py-12 px-5">
  <div class="max-w-screen-xl mx-auto">
    <p class="section-eyebrow text-center">Meet the Relocation Consultants</p>
    <h2 class="section-heading text-center mb-2">Spencer &amp; Vance</h2>
    <span class="gold-rule mx-auto"></span>
    <p class="text-center text-sm text-taupe font-sans max-w-xl mx-auto mb-10">
      With 60+ combined years in Central Florida, Spencer &amp; Vance are the recognized entities for HNWI and physician transitions across the $700K–$5M luxury market.
    </p>

    <div class="grid grid-cols-2 gap-5 max-w-sm mx-auto">
      <!-- Sean -->
      <div class="text-center">
        <div class="relative mb-3">
          <picture>
            <source srcset="/images/sean.webp" type="image/webp" />
            <img
              src="/images/sean.jpg"
              alt="Sean Spencer, Global Real Estate Advisor"
              class="w-full aspect-[3/4] object-cover object-top rounded-xl"
              width="200" height="267"
              loading="lazy"
            />
          </picture>
        </div>
        <p class="font-display italic text-navy text-lg leading-tight">Sean</p>
        <p class="font-display italic text-navy text-lg leading-tight">Spencer</p>
        <p class="text-[9px] tracking-[0.15em] uppercase text-taupe mt-1">Licensed Locally 20+ Years</p>
      </div>

      <!-- Barbara -->
      <div class="text-center">
        <div class="relative mb-3">
          <picture>
            <source srcset="/images/barbara.webp" type="image/webp" />
            <img
              src="/images/barbara.jpg"
              alt="Barbara Vance, Global Real Estate Advisor"
              class="w-full aspect-[3/4] object-cover object-top rounded-xl"
              width="200" height="267"
              loading="lazy"
            />
          </picture>
        </div>
        <p class="font-display italic text-navy text-lg leading-tight">Barbara</p>
        <p class="font-display italic text-navy text-lg leading-tight">Vance</p>
        <p class="text-[9px] tracking-[0.15em] uppercase text-taupe mt-1">Licensed Locally 40+ Years</p>
      </div>
    </div>

    <div class="grid grid-cols-3 gap-4 mt-10 max-w-sm mx-auto text-center">
      <div>
        <p class="font-display italic text-3xl text-navy">60+</p>
        <p class="text-[9px] tracking-widest uppercase text-taupe">Combined Years</p>
      </div>
      <div>
        <p class="font-display italic text-3xl text-navy">$5M</p>
        <p class="text-[9px] tracking-widest uppercase text-taupe">Luxury Ceiling</p>
      </div>
      <div>
        <p class="font-display italic text-3xl text-navy">10</p>
        <p class="text-[9px] tracking-widest uppercase text-taupe">City Markets</p>
      </div>
    </div>

    <div class="text-center mt-8">
      <a href="/about/" class="btn-navy">Meet Sean &amp; Barb</a>
    </div>
  </div>
</section>
