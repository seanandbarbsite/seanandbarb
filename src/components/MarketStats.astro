---
export interface Props {
  stats: {
    medianPrice: string;
    priceRange: string;
    avgDaysOnMarket: number;
    activeListings: number;
    pricePerSqFt: string;
  };
  lastUpdated: string;
  cityName: string;
}
const { stats, lastUpdated, cityName } = Astro.props;
---

<div class="bg-navy rounded-2xl overflow-hidden">
  <div class="px-5 py-3 bg-navy-dark flex items-center justify-between">
    <p class="text-[9px] tracking-[0.25em] uppercase text-gold">Last Updated {lastUpdated}</p>
    <p class="text-[9px] tracking-[0.2em] uppercase text-white/40">{cityName} Luxury Pulse</p>
  </div>
  <div class="grid grid-cols-2 gap-px bg-white/10">
    <div class="bg-navy px-5 py-4">
      <p class="text-[9px] tracking-widest uppercase text-white/40 mb-1">Median List Price</p>
      <p class="font-display italic text-2xl text-white">{stats.medianPrice}</p>
    </div>
    <div class="bg-navy px-5 py-4">
      <p class="text-[9px] tracking-widest uppercase text-white/40 mb-1">Price Range</p>
      <p class="font-display italic text-xl text-white">{stats.priceRange}</p>
    </div>
    <div class="bg-navy px-5 py-4">
      <p class="text-[9px] tracking-widest uppercase text-white/40 mb-1">Avg Days on Market</p>
      <p class="font-display italic text-2xl text-gold-bright">{stats.avgDaysOnMarket} <span class="text-base text-white/60">days</span></p>
    </div>
    <div class="bg-navy px-5 py-4">
      <p class="text-[9px] tracking-widest uppercase text-white/40 mb-1">Price / Sq Ft</p>
      <p class="font-display italic text-2xl text-white">{stats.pricePerSqFt}</p>
    </div>
  </div>
  <div class="px-5 py-3 text-center">
    <p class="text-xs text-white/30 font-sans">Active luxury listings: <span class="text-white/60">{stats.activeListings}</span> · Data refreshed {lastUpdated}</p>
  </div>
</div>
