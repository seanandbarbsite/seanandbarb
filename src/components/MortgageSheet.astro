---
---
<div id="mortgage-sheet" class="slide-panel fixed inset-x-0 bottom-0 z-[90] bg-white flex flex-col" style="height: 90dvh; border-radius: 20px 20px 0 0; overflow-y: auto;">
  <div class="bg-navy px-5 py-4 flex items-center justify-between flex-shrink-0" style="border-radius: 20px 20px 0 0;">
    <div>
      <p class="text-white font-display italic text-lg">Mortgage ROI Calculator</p>
      <p class="text-white/50 text-xs font-sans">vs. your current state tax burden</p>
    </div>
    <button id="mortgage-close" class="text-white/60 text-xl">✕</button>
  </div>

  <div class="p-5 space-y-4">
    <div class="grid grid-cols-2 gap-3">
      <div>
        <label class="block text-[9px] tracking-[0.2em] uppercase text-taupe mb-1">Home Price</label>
        <input id="m-price" type="number" value="1200000" class="w-full border border-gray-200 rounded px-3 py-2 text-sm font-sans" />
      </div>
      <div>
        <label class="block text-[9px] tracking-[0.2em] uppercase text-taupe mb-1">Down Payment %</label>
        <input id="m-down" type="number" value="20" class="w-full border border-gray-200 rounded px-3 py-2 text-sm font-sans" />
      </div>
      <div>
        <label class="block text-[9px] tracking-[0.2em] uppercase text-taupe mb-1">Interest Rate %</label>
        <input id="m-rate" type="number" value="6.75" step="0.01" class="w-full border border-gray-200 rounded px-3 py-2 text-sm font-sans" />
      </div>
      <div>
        <label class="block text-[9px] tracking-[0.2em] uppercase text-taupe mb-1">Annual Income</label>
        <input id="m-income" type="number" value="400000" class="w-full border border-gray-200 rounded px-3 py-2 text-sm font-sans" />
      </div>
    </div>

    <div>
      <label class="block text-[9px] tracking-[0.2em] uppercase text-taupe mb-1">Current State</label>
      <select id="m-state" class="w-full border border-gray-200 rounded px-3 py-2 text-sm font-sans">
        <option value="0">Florida (0%)</option>
        <option value="0.0685">New York (6.85%)</option>
        <option value="0.0897">New Jersey (8.97%)</option>
        <option value="0.133">California (13.3%)</option>
        <option value="0.0499">Illinois (4.99%)</option>
        <option value="0.0699">Connecticut (6.99%)</option>
        <option value="0.09">Massachusetts (9%)</option>
      </select>
    </div>

    <button id="m-calc" class="w-full bg-navy text-white py-3 text-xs tracking-[0.2em] uppercase font-sans">Calculate Savings</button>

    <div id="m-results" class="hidden space-y-3">
      <div class="bg-cream rounded-xl p-4">
        <p class="text-[9px] tracking-widest uppercase text-taupe mb-1">Monthly Mortgage Payment</p>
        <p id="m-monthly" class="font-display italic text-2xl text-navy"></p>
      </div>
      <div class="bg-gold/10 border border-gold/30 rounded-xl p-4">
        <p class="text-[9px] tracking-widest uppercase text-taupe mb-1">Annual Florida Tax Savings</p>
        <p id="m-annual" class="font-display italic text-2xl text-navy"></p>
        <p class="text-xs text-taupe mt-1">vs. your current state</p>
      </div>
      <div class="bg-navy rounded-xl p-4">
        <p class="text-[9px] tracking-widest uppercase text-white/50 mb-1">10-Year Total Savings</p>
        <p id="m-decade" class="font-display italic text-2xl text-gold-bright"></p>
      </div>
    </div>

    <div class="border-t border-gray-100 pt-4">
      <a href="tel:4073830707" class="block w-full bg-gold text-white text-center py-3 text-xs tracking-[0.2em] uppercase font-sans">
        Discuss Physician Loan Options
      </a>
    </div>
  </div>
</div>

<script>
  document.getElementById('mortgage-close')?.addEventListener('click', () => {
    document.getElementById('mortgage-sheet')?.classList.remove('open');
  });

  document.getElementById('m-calc')?.addEventListener('click', () => {
    const price = parseFloat((document.getElementById('m-price') as HTMLInputElement).value) || 0;
    const down = parseFloat((document.getElementById('m-down') as HTMLInputElement).value) / 100;
    const rate = parseFloat((document.getElementById('m-rate') as HTMLInputElement).value) / 100 / 12;
    const income = parseFloat((document.getElementById('m-income') as HTMLInputElement).value) || 0;
    const stateRate = parseFloat((document.getElementById('m-state') as HTMLSelectElement).value) || 0;

    const loan = price * (1 - down);
    const n = 360;
    const monthly = rate === 0 ? loan / n : loan * rate * Math.pow(1 + rate, n) / (Math.pow(1 + rate, n) - 1);
    const annualSavings = income * stateRate;
    const decadeSavings = annualSavings * 10;

    const fmt = (n: number) => '$' + Math.round(n).toLocaleString();

    (document.getElementById('m-monthly') as HTMLElement).textContent = fmt(monthly) + '/mo';
    (document.getElementById('m-annual') as HTMLElement).textContent = fmt(annualSavings);
    (document.getElementById('m-decade') as HTMLElement).textContent = fmt(decadeSavings);
    document.getElementById('m-results')?.classList.remove('hidden');
  });
</script>
