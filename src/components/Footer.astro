---
const cities = [
  { name: 'Windermere', slug: 'windermere' },
  { name: 'Dr. Phillips', slug: 'dr-phillips' },
  { name: 'Winter Park', slug: 'winter-park' },
  { name: 'Lake Nona', slug: 'lake-nona' },
  { name: 'Orlando', slug: 'orlando' },
  { name: 'Winter Garden', slug: 'winter-garden' },
  { name: 'Maitland', slug: 'maitland' },
  { name: 'Longwood', slug: 'longwood' },
  { name: 'Lake Mary', slug: 'lake-mary' },
  { name: 'Oviedo', slug: 'oviedo' },
];
---

<footer class="bg-[#001428] text-white/70 pt-16 pb-8">
  <div class="max-w-screen-xl mx-auto px-5">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-10 mb-12">

      <!-- Column 1: Brand -->
      <div>
        <img
          src="/images/premier-sothebys-vertical-white.gif"
          alt="Premier Sotheby's International Realty"
          class="h-14 w-auto mb-5 opacity-80"
          width="100" height="56"
        />
        <p class="font-display italic text-xl text-white mb-1">Sean &amp; Barb</p>
        <p class="text-xs tracking-widest uppercase text-gold mb-4">Spencer · Vance</p>
        <p class="text-sm leading-relaxed">
          60+ years of hyperlocal Central Florida expertise.<br />
          Luxury real estate $700K–$5M.
        </p>
        <div class="flex gap-4 mt-5">
          <a href="https://www.instagram.com/seanandbarbrealtors/" target="_blank" rel="noopener" aria-label="Instagram" class="text-white/50 hover:text-gold transition-colors">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>
          </a>
          <a href="https://www.facebook.com/SeanAndBarbRealtors" target="_blank" rel="noopener" aria-label="Facebook" class="text-white/50 hover:text-gold transition-colors">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
          </a>
          <a href="https://www.linkedin.com/in/seanandbarbrealtors/" target="_blank" rel="noopener" aria-label="LinkedIn" class="text-white/50 hover:text-gold transition-colors">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
          </a>
        </div>
      </div>

      <!-- Column 2: Cities -->
      <div>
        <p class="text-[9px] tracking-[0.25em] uppercase text-gold mb-4">Markets We Serve</p>
        <ul class="space-y-2">
          {cities.map(c => (
            <li>
              <a href={`/cities/${c.slug}-homes-for-sale/`} class="text-sm text-white/60 hover:text-white transition-colors">
                {c.name}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Column 3: Contact -->
      <div>
        <p class="text-[9px] tracking-[0.25em] uppercase text-gold mb-4">Contact Us</p>
        <address class="not-italic text-sm leading-7 text-white/60">
          <p>1117 International Parkway</p>
          <p>Suite 1711</p>
          <p>Lake Mary, FL 32746</p>
          <a href="tel:4073830707" class="block mt-3 hover:text-white transition-colors">(407) 383-0707</a>
          <a href="mailto:sean@seanandbarb.com" class="block hover:text-white transition-colors">sean@seanandbarb.com</a>
        </address>
        <a
          href="/contact/"
          class="inline-block mt-6 px-6 py-2 border border-gold/40 text-gold text-xs tracking-[0.2em] uppercase hover:border-gold hover:text-gold-bright transition-colors duration-200"
        >
          Schedule a Call
        </a>
      </div>
    </div>

    <!-- Bottom bar -->
    <div class="border-t border-white/10 pt-6 flex flex-col md:flex-row justify-between items-center gap-3 text-xs text-white/30">
      <p>© {new Date().getFullYear()} Sean Spencer &amp; Barbara Vance · Premier Sotheby's International Realty · All Rights Reserved</p>
      <p>Licensed Locally · Central Florida Luxury Specialists</p>
    </div>
  </div>
</footer>
